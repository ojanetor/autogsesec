# AutoGSESec environment variables: safe placeholders only.
# Local development needs NONE of these. Never commit real values.
# Production values are set in the Render dashboard (Environment tab).
# The app reads real environment variables; it does not load this file itself.

# --- Production (required when RENDER=true or APP_ENV=production) ---
# Long random string. On Render use "Generate".
SECRET_KEY=change-me-to-a-long-random-string
# Render Postgres "Internal Database URL" (postgres://... is converted automatically)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Mode ---
# Render sets RENDER=true itself. Use APP_ENV=production to test production rules elsewhere.
# APP_ENV=production

# --- Local development only ---
# FLASK_DEBUG=1

# --- Tests ---
# Run the test suite against Postgres instead of in-memory SQLite.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autogsesec_test

